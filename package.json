{
  "name": "what-the-hunk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "catalog": {
    "@biomejs/biome": "^2.5.11",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@opencode-ai/plugin": "0.0.0-dev-18567",
    "@opencode-ai/sdk": "0.0.0-dev-18567",
    "effect": "4.0.0-rc.112",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5",
    "@types/bun": "latest"
  },
  "scripts": {
    "test": "bun test packages apps",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/viewer/tsconfig.browser.json",
    "check": "biome check packages apps",
    "fix": "biome check --write packages apps",
    "ktm": "bun run apps/cli/src/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
